# Copy to .env and fill in. NEVER commit .env (contains secrets).

APP_ADDR=127.0.0.1:8080
# PostgreSQL 13+
DATABASE_URL=postgres://storyboard:CHANGE_ME@localhost:5432/storyboard?sslmode=disable
# ---- Login (individual accounts) ----
# First admin, created ONLY when the users table is empty. Must be >= 12 chars and must
# not contain the username. Change it at first login, then REMOVE ADMIN_PASSWORD.
# Alternative: run `storyboard reset-password <username>` (prints a one-time password).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Session lifetime (absolute) and idle timeout
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=60
# Set true when served over HTTPS (behind a TLS reverse proxy)
COOKIE_SECURE=false
DATA_DIR=./data
MAX_UPLOAD_MB=100

# ---- Claude (storyboard, voice over script, image/video prompts) ----
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_DISABLED=true

# Behind Dokploy/Traefik: TRUST_PROXY=true, COOKIE_SECURE=true
TRUST_PROXY=false

# ---- Final render (ffmpeg) ----
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# ---- Social publishing (YouTube Shorts, Instagram Reels, Threads, TikTok) ----
# Public HTTPS URL of this app: used for OAuth redirect URIs
#   {PUBLIC_BASE_URL}/oauth/{youtube|instagram|threads|tiktok}/callback
# and for signed, expiring video URLs that Instagram/Threads download.
PUBLIC_BASE_URL=
# Encrypts OAuth tokens at rest (AES-256-GCM). 32 random bytes, base64:
#   powershell: [Convert]::ToBase64String((1..32|%{Get-Random -Max 256}))
#   linux:      openssl rand -base64 32
# Losing/changing it means all accounts must be reconnected.
TOKEN_ENC_KEY=
# true = every post needs "Setujui" before the scheduler publishes it
POST_APPROVAL=true
# Google Cloud → OAuth client (Web) + YouTube Data API v3
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# TikTok for Developers → Login Kit + Content Posting API (Direct Post)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Meta → Instagram API with Instagram Login
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_GRAPH_VERSION=v27.0
# Meta → Threads API
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_GRAPH_VERSION=v1.0

# ---- Image / Video / TTS providers ----
# "mock" = offline placeholders. "byteplus" = BytePlus ModelArk (Seedream / Seedance).
# "http" = generic JSON adapter (see README "Provider contract").

# ---- BytePlus ModelArk (IMAGE_PROVIDER=byteplus / VIDEO_PROVIDER=byteplus) ----
# API key: ModelArk console → API Key Management. Model: model ID or endpoint ID (ep-...) that is
# activated in your ModelArk console (Seedream for images, Seedance for video).
BYTEPLUS_API_KEY=
BYTEPLUS_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
BYTEPLUS_IMAGE_MODEL=
BYTEPLUS_VIDEO_MODEL=
# Empty = derived from project aspect ratio (2560x1440, 1440x2560, 2048x2048, 1792x2240)
BYTEPLUS_IMAGE_SIZE=
BYTEPLUS_VIDEO_RESOLUTION=720p
# Scene duration is rounded and clamped to the range the chosen Seedance model supports
BYTEPLUS_VIDEO_MIN_SEC=5
BYTEPLUS_VIDEO_MAX_SEC=10
BYTEPLUS_WATERMARK=false

IMAGE_PROVIDER=mock
IMAGE_API_URL=
IMAGE_API_KEY=

VIDEO_PROVIDER=mock
VIDEO_API_URL=
VIDEO_API_KEY=

# TTS_PROVIDER: mock | openai | http
TTS_PROVIDER=mock

# ---- OpenAI text-to-speech (TTS_PROVIDER=openai) — /v1/audio/speech (not Whisper) ----
OPENAI_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# alloy, ash, ballad, coral, echo, fable, nova, onyx, sage, shimmer, verse
OPENAI_TTS_VOICE=alloy
# Speaking style (gpt-4o-mini-tts only), e.g. "Warm, friendly narrator, medium pace"
OPENAI_TTS_INSTRUCTIONS=
OPENAI_TTS_SPEED=1.0
TTS_API_URL=
TTS_API_KEY=
TTS_VOICE=default
